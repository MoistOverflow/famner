# Copy to /opt/famner/.env (or wherever the app lives) and adjust.

# Where the server listens. nginx proxies to this; keep it on localhost.
HOST=127.0.0.1
PORT=3000

# The address people type in the browser (no trailing slash). Needed so form posts pass
# SvelteKit's cross-site check behind nginx. Change to https://… once nginx does HTTPS.
ORIGIN=http://home.local

# nginx passes the visitor's address in this header (used to slow down password guessing per device).
ADDRESS_HEADER=X-Real-IP

# The database, and where backups go (ideally a different disk or a synced folder).
CALENDAR_DB=/opt/famner/data/calendar.db
BACKUP_DIR=/opt/famner/backups

# The household's time zone (used for things the server prints; chores use the browser's zone).
TZ=America/New_York

# Allow large calendar imports / subscriptions to be saved in one go.
BODY_SIZE_LIMIT=2M
